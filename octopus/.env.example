# Copy to .env and replace values. Do not commit .env.
OCTOPUS_VERSION=2026.2.13319
KUBECTL_VERSION=v1.35.2
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU26-ubuntu-22.04

# Must satisfy SQL Server password complexity.
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_123!

OCTOPUS_ADMIN_USERNAME=admin
OCTOPUS_ADMIN_PASSWORD=CHANGE_ME_Admin_123!
OCTOPUS_ADMIN_EMAIL=admin@beacon.local

# Stable encryption key. Generate with: openssl rand 16 | base64
OCTOPUS_MASTER_KEY=

# May be left blank first; current Octopus container attempts a free license.
# If automatic licensing fails, paste your Base64 self-hosted license here.
OCTOPUS_SERVER_BASE64_LICENSE=
